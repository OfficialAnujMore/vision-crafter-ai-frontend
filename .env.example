# --- Required ---

# Backend API base URL
VITE_API_URL=http://localhost:8000

# Google OAuth client ID
# https://console.cloud.google.com/apis/credentials
# Add http://localhost:5173 to "Authorized JavaScript origins"
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com


# --- Optional: Unsplash background search ---
# Without these, the Unsplash tab in the Background Image panel shows a
# "not configured" hint; every other feature works as normal.
VITE_UNSPLASH_API_URL=https://api.unsplash.com
VITE_UNSPLASH_ACCESS_KEY=your-unsplash-access-key
