# Google OAuth Configuration (REQUIRED)
# Get this from https://console.cloud.google.com/apis/credentials
# Make sure to add http://localhost:5173 to Authorized JavaScript origins
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backend API URL
VITE_API_URL=http://localhost:8000

# ImageKit Configuration (REQUIRED for image uploads)
# Get credentials from https://imagekit.io/dashboard/developer/api-keys
VITE_IMAGEKIT_UPLOAD_URL=https://upload.imagekit.io/api/v1/files/upload
VITE_IMAGEKIT_PUBLIC_KEY=public_your_public_key_here
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
VITE_IMAGEKIT_PRIVATE_KEY=private_your_private_key_here
